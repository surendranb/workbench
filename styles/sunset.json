{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Sunset",
	"description": "Tamil Nadu countryside sunset: warm glowing sunset peach canvas, dusk cirrus slate rail, silhouetted palmyra palm ink, fiery horizon orange accent, and twilight cobalt secondary.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#fdf0e2", "name": "Sunset Peach Canvas" },
				{ "slug": "ink", "color": "#140b04", "name": "Palmyrah Silhouette Obsidian" },
				{ "slug": "accent", "color": "#ea580c", "name": "Fiery Horizon Orange" },
				{ "slug": "secondary", "color": "#1e3a8a", "name": "Twilight Cirrus Cobalt" },
				{ "slug": "sidebar", "color": "#d8e2eb", "name": "Dusk Cirrus Slate Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Plaster Surface" },
				{ "slug": "title", "color": "#140b04", "name": "Palmyrah Silhouette Title" },
				{ "slug": "body", "color": "#24160d", "name": "Deep Ember Charcoal Body" },
				{ "slug": "lede", "color": "#382518", "name": "Dusk Horizon Lede" },
				{ "slug": "muted", "color": "#635246", "name": "Twilight Timber Muted" },
				{ "slug": "faint", "color": "#948276", "name": "Faint" },
				{ "slug": "border", "color": "#fed7aa", "name": "Sunset Glow Border" },
				{ "slug": "hairline", "color": "#fee9d7", "name": "Sunset Hairline" },
				{ "slug": "accent-strong", "color": "#c2410c", "name": "Deep Sunset Ember" },
				{ "slug": "accent-wash", "color": "#ffedd5", "name": "Sunset Glow Wash" },
				{ "slug": "accent-border", "color": "#fdba74", "name": "Sunset Glow Border" },
				{ "slug": "accent-text", "color": "#9a3412", "name": "Sunset Glow Text" },
				{ "slug": "secondary-wash", "color": "#eff3fa", "name": "Twilight Wash" },
				{ "slug": "secondary-border", "color": "#bfdbfe", "name": "Twilight Border" },
				{ "slug": "secondary-text", "color": "#1e3a8a", "name": "Twilight Text" },
				{ "slug": "live", "color": "#ea580c", "name": "Sunset Fire Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
					"fontWeight": "800",
					"letterSpacing": "-0.035em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
