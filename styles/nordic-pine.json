{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Nordic Pine",
	"description": "Focused botanical lab: pale alpine mint canvas, frosted pine mist rail, deep forest charcoal ink, vivid emerald green accent, and Geist clean typography.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#f0f6f3", "name": "Alpine Mint Canvas" },
				{ "slug": "ink", "color": "#081a13", "name": "Forest Charcoal Ink" },
				{ "slug": "accent", "color": "#0d7e5d", "name": "Vivid Forest Emerald" },
				{ "slug": "secondary", "color": "#0e7490", "name": "Glacier Cyan" },
				{ "slug": "sidebar", "color": "#dce8e1", "name": "Pine Mist Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#081a13", "name": "Forest Title" },
				{ "slug": "body", "color": "#1e352b", "name": "Spruce Green-Gray Body" },
				{ "slug": "lede", "color": "#2d4d3f", "name": "Spruce Lede" },
				{ "slug": "muted", "color": "#5b7a6d", "name": "Spruce Muted" },
				{ "slug": "faint", "color": "#8fa89d", "name": "Faint" },
				{ "slug": "border", "color": "#c7d8ce", "name": "Spruce Border" },
				{ "slug": "hairline", "color": "#dce8e1", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#065f46", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#ecfdf5", "name": "Emerald Wash" },
				{ "slug": "accent-border", "color": "#a7f3d0", "name": "Emerald Border" },
				{ "slug": "accent-text", "color": "#065f46", "name": "Emerald Text" },
				{ "slug": "secondary-wash", "color": "#ecfeff", "name": "Glacier Wash" },
				{ "slug": "secondary-border", "color": "#a5f3fc", "name": "Glacier Border" },
				{ "slug": "secondary-text", "color": "#155e75", "name": "Glacier Text" },
				{ "slug": "live", "color": "#0d7e5d", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--geist)",
					"fontWeight": "750",
					"letterSpacing": "-0.03em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
