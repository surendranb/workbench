{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Granite Ridge",
	"description": "Cool overcast slate mist, wet granite basalt ink, and vibrant laterite clay accent.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "page", "color": "#f4f6f8", "name": "Page" },
				{ "slug": "ink", "color": "#18222c", "name": "Ink" },
				{ "slug": "title", "color": "#232f3a", "name": "Title" },
				{ "slug": "body", "color": "#2e3d4b", "name": "Body" },
				{ "slug": "lede", "color": "#3a4a58", "name": "Lede" },
				{ "slug": "muted", "color": "#5d7082", "name": "Muted" },
				{ "slug": "faint", "color": "#8a9ba8", "name": "Faint" },
				{ "slug": "border", "color": "#dbe2e8", "name": "Border" },
				{ "slug": "hairline", "color": "#ebf0f4", "name": "Hairline" },
				{ "slug": "accent", "color": "#c25e2e", "name": "Accent" },
				{ "slug": "accent-strong", "color": "#aa4d20", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fdf4ee", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#f5d4c2", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#c25e2e", "name": "Accent Text" },
				{ "slug": "secondary", "color": "#8297ab", "name": "Secondary" },
				{ "slug": "live", "color": "#486940", "name": "Live" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			}
		}
	}
}
