{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Chaparral Dusk",
	"description": "Rolling golden oat grass, deep asphalt carbon ink, and glowing sunset amber horizon.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "page", "color": "#faf8f4", "name": "Page" },
				{ "slug": "ink", "color": "#1e2024", "name": "Ink" },
				{ "slug": "title", "color": "#2a2b30", "name": "Title" },
				{ "slug": "body", "color": "#33353c", "name": "Body" },
				{ "slug": "lede", "color": "#4a4947", "name": "Lede" },
				{ "slug": "muted", "color": "#6c6a66", "name": "Muted" },
				{ "slug": "faint", "color": "#99958d", "name": "Faint" },
				{ "slug": "border", "color": "#e6e0d4", "name": "Border" },
				{ "slug": "hairline", "color": "#f2ede3", "name": "Hairline" },
				{ "slug": "accent", "color": "#d97026", "name": "Accent" },
				{ "slug": "accent-strong", "color": "#be5c17", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fef4eb", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#f9d4b8", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#be5c17", "name": "Accent Text" },
				{ "slug": "secondary", "color": "#6b7f99", "name": "Secondary" },
				{ "slug": "live", "color": "#5a7348", "name": "Live" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			}
		}
	}
}
