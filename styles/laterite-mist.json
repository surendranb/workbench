{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Laterite Mist",
	"description": "Vibrant sun-baked red laterite earth, lush coconut palm canopy green, deep soil umber, and misty sandstone wash.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#f7efe3", "name": "Misty Sandstone Canvas" },
				{ "slug": "ink", "color": "#1c1009", "name": "Deep Soil Umber" },
				{ "slug": "accent", "color": "#c2410c", "name": "Plowed Red Laterite" },
				{ "slug": "secondary", "color": "#245836", "name": "Palm Canopy Green" },
				{ "slug": "sidebar", "color": "#e5d4bf", "name": "Warm Clay Mist" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#26150b", "name": "Title" },
				{ "slug": "body", "color": "#382317", "name": "Body" },
				{ "slug": "lede", "color": "#4e3526", "name": "Lede" },
				{ "slug": "muted", "color": "#705544", "name": "Muted" },
				{ "slug": "faint", "color": "#9e8372", "name": "Faint" },
				{ "slug": "border", "color": "#d3bfab", "name": "Warm Clay Border" },
				{ "slug": "hairline", "color": "#e6d7c5", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#9e3206", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fbeae3", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#f5bfa9", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#9e3206", "name": "Accent Text" },
				{ "slug": "live", "color": "#245836", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
