{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Laterite Mist",
	"description": "Warm sun-baked sandstone mist canvas, rich plowed red laterite earth, lush palm canopy green, and deep roasted umber soil.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#f3e7d3", "name": "Misty Sandstone Canvas" },
				{ "slug": "ink", "color": "#2a140a", "name": "Roasted Umber Soil" },
				{ "slug": "accent", "color": "#c2410c", "name": "Plowed Red Laterite" },
				{ "slug": "secondary", "color": "#1b5e20", "name": "Palm Canopy Green" },
				{ "slug": "sidebar", "color": "#e2d1b7", "name": "Warm Clay Mist Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#32180c", "name": "Deep Umber Timber Title" },
				{ "slug": "body", "color": "#48291a", "name": "Warm Soil Body Text" },
				{ "slug": "lede", "color": "#5c3724", "name": "Lede" },
				{ "slug": "muted", "color": "#7e5842", "name": "Misty Loam Muted" },
				{ "slug": "faint", "color": "#a6836e", "name": "Faint" },
				{ "slug": "border", "color": "#ccb495", "name": "Sandstone Trail Border" },
				{ "slug": "hairline", "color": "#e2cfb7", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#9e3206", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fdf0ea", "name": "Laterite Accent Wash" },
				{ "slug": "accent-border", "color": "#f7cbba", "name": "Laterite Accent Border" },
				{ "slug": "accent-text", "color": "#9e3206", "name": "Laterite Accent Text" },
				{ "slug": "secondary-wash", "color": "#eaf4eb", "name": "Palm Green Wash" },
				{ "slug": "secondary-border", "color": "#b9dcbe", "name": "Palm Green Border" },
				{ "slug": "secondary-text", "color": "#144a19", "name": "Palm Green Text" },
				{ "slug": "live", "color": "#1b5e20", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
