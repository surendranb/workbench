{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Chettinad Teak",
	"description": "Hand-beaten eggshell lime plaster canvas, seasoned heartwood teak ink, lacquered temple cinnabar accent, and courtyard aged brass.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#f5f0e6", "name": "Eggshell Lime Plaster Canvas" },
				{ "slug": "ink", "color": "#22160e", "name": "Seasoned Heartwood Teak Ink" },
				{ "slug": "accent", "color": "#ba3820", "name": "Lacquered Temple Cinnabar" },
				{ "slug": "secondary", "color": "#856930", "name": "Courtyard Aged Brass" },
				{ "slug": "sidebar", "color": "#e5ddcd", "name": "Weathered Lime-Mortar Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Athangudi Polished White" },
				{ "slug": "title", "color": "#2e1e14", "name": "Heartwood Timber Title" },
				{ "slug": "body", "color": "#422e20", "name": "Oiled Teak Body" },
				{ "slug": "lede", "color": "#594130", "name": "Lede" },
				{ "slug": "muted", "color": "#7a614d", "name": "Aged Timber Muted" },
				{ "slug": "faint", "color": "#a8927e", "name": "Faint" },
				{ "slug": "border", "color": "#d4c7b2", "name": "Mortar Joinery Border" },
				{ "slug": "hairline", "color": "#e8dfd1", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#992813", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fdf0ee", "name": "Cinnabar Wash" },
				{ "slug": "accent-border", "color": "#f8c2b7", "name": "Cinnabar Border" },
				{ "slug": "accent-text", "color": "#992813", "name": "Cinnabar Text" },
				{ "slug": "secondary-wash", "color": "#f9f4ea", "name": "Aged Brass Wash" },
				{ "slug": "secondary-border", "color": "#dfd0b0", "name": "Aged Brass Border" },
				{ "slug": "secondary-text", "color": "#634c1d", "name": "Aged Brass Text" },
				{ "slug": "live", "color": "#856930", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
