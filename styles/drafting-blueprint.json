{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Drafting Blueprint",
	"description": "1970s technical drafting table: blueprint wash canvas, precision caliper rail, technical deep navy ink, high-voltage hazard orange accent, and Space Grotesk geometric drafting typography.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#eef5fa", "name": "Blueprint Cyan Wash Canvas" },
				{ "slug": "ink", "color": "#081e36", "name": "Drafting Deep Navy Ink" },
				{ "slug": "accent", "color": "#ea580c", "name": "Hazard Orange Accent" },
				{ "slug": "secondary", "color": "#0369a1", "name": "Marine Blueprint Blue" },
				{ "slug": "sidebar", "color": "#dbe8f3", "name": "Precision Caliper Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#081e36", "name": "Drafting Navy Title" },
				{ "slug": "body", "color": "#1b324b", "name": "Technical Steel Charcoal Body" },
				{ "slug": "lede", "color": "#294767", "name": "Drafting Lede" },
				{ "slug": "muted", "color": "#567494", "name": "Drafting Muted" },
				{ "slug": "faint", "color": "#8ba7c4", "name": "Faint" },
				{ "slug": "border", "color": "#bcd3e6", "name": "Caliper Border" },
				{ "slug": "hairline", "color": "#d5e4f0", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#c2410c", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fff7ed", "name": "Orange Wash" },
				{ "slug": "accent-border", "color": "#fed7aa", "name": "Orange Border" },
				{ "slug": "accent-text", "color": "#c2410c", "name": "Orange Text" },
				{ "slug": "secondary-wash", "color": "#f0f9ff", "name": "Marine Wash" },
				{ "slug": "secondary-border", "color": "#bae6fd", "name": "Marine Border" },
				{ "slug": "secondary-text", "color": "#0369a1", "name": "Marine Text" },
				{ "slug": "live", "color": "#ea580c", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "700",
					"letterSpacing": "-0.03em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
