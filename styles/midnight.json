{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Midnight",
	"description": "Full dark mode. Indigo glow on lacquer black.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "surface", "color": "#111827", "name": "Surface" },
				{ "slug": "page", "color": "#0b1120", "name": "Page" },
				{ "slug": "ink", "color": "#f8fafc", "name": "Ink" },
				{ "slug": "title", "color": "#e2e8f0", "name": "Title" },
				{ "slug": "body", "color": "#cbd5e1", "name": "Body" },
				{ "slug": "lede", "color": "#94a3b8", "name": "Lede" },
				{ "slug": "muted", "color": "#94a3b8", "name": "Muted" },
				{ "slug": "faint", "color": "#8494ab", "name": "Faint" },
				{ "slug": "border", "color": "#2a3444", "name": "Border" },
				{ "slug": "hairline", "color": "#1e2939", "name": "Hairline" },
				{ "slug": "accent", "color": "#818cf8", "name": "Accent" },
				{ "slug": "accent-strong", "color": "#a5b4fc", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#1e1b4b", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#3730a3", "name": "Accent Border" },
