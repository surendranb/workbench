{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Coastal Dusk",
	"description": "Luminous coastal sand, incandescent coral-dusk horizon ribbon, breaking seafoam surf, and deep oceanic navy.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#f4f6f4", "name": "Coastal Sand Canvas" },
				{ "slug": "ink", "color": "#091621", "name": "Oceanic Deep Navy" },
				{ "slug": "accent", "color": "#ea4e33", "name": "Sunset Coral Ember" },
				{ "slug": "secondary", "color": "#167883", "name": "Seafoam Surf Teal" },
				{ "slug": "sidebar", "color": "#dce5e1", "name": "Coastal Slate Mist" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#0e202d", "name": "Title" },
				{ "slug": "body", "color": "#1d3240", "name": "Body" },
				{ "slug": "lede", "color": "#314959", "name": "Lede" },
				{ "slug": "muted", "color": "#546e7f", "name": "Muted" },
				{ "slug": "faint", "color": "#859dae", "name": "Faint" },
				{ "slug": "border", "color": "#c4d1cc", "name": "Sea-Mineral Border" },
				{ "slug": "hairline", "color": "#dbe3e0", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#cf381e", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#feeeeb", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#fbc2b7", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#cf381e", "name": "Accent Text" },
				{ "slug": "live", "color": "#167883", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
