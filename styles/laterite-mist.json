{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Laterite Mist",
	"description": "Rich plowed laterite red earth, deep umber soil ink, palm canopy green, and warm mist canvas.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "page", "color": "#f6eee3", "name": "Page" },
				{ "slug": "ink", "color": "#24160d", "name": "Ink" },
				{ "slug": "title", "color": "#332014", "name": "Title" },
				{ "slug": "body", "color": "#2e1e14", "name": "Body" },
				{ "slug": "lede", "color": "#4a3222", "name": "Lede" },
				{ "slug": "muted", "color": "#6e5746", "name": "Muted" },
				{ "slug": "faint", "color": "#947e6e", "name": "Faint" },
				{ "slug": "border", "color": "#ded0bd", "name": "Border" },
				{ "slug": "hairline", "color": "#ede2d3", "name": "Hairline" },
				{ "slug": "accent", "color": "#bf491b", "name": "Accent" },
				{ "slug": "accent-strong", "color": "#a13a10", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fef1eb", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#f8c7b3", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#a13a10", "name": "Accent Text" },
				{ "slug": "secondary", "color": "#335c34", "name": "Secondary" },
				{ "slug": "live", "color": "#335c34", "name": "Live" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			}
		}
	}
}
