{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Nandi",
	"description": "Monsoon over Nandi Hills: warm ploughed Deccan red earth canvas, monsoon cloud granite rail, deep forest granite shadow ink, blazing Deccan terracotta red accent, and lush coconut palm emerald secondary.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#fbf0e6", "name": "Deccan Red Earth Canvas" },
				{ "slug": "ink", "color": "#0f1d17", "name": "Granite Cliff Shadow Ink" },
				{ "slug": "accent", "color": "#c2410c", "name": "Deccan Terracotta Red" },
				{ "slug": "secondary", "color": "#166534", "name": "Monsoon Palm Emerald" },
				{ "slug": "sidebar", "color": "#dce5eb", "name": "Monsoon Granite Mist Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Limestone Wall Surface" },
				{ "slug": "title", "color": "#0f1d17", "name": "Granite Shadow Title" },
				{ "slug": "body", "color": "#1e2c23", "name": "Forest Charcoal Body" },
				{ "slug": "lede", "color": "#2c4033", "name": "Granite Lede" },
				{ "slug": "muted", "color": "#586e61", "name": "Mountain Mist Muted" },
				{ "slug": "faint", "color": "#8ea296", "name": "Faint" },
				{ "slug": "border", "color": "#ebd5c5", "name": "Clay Furrow Border" },
				{ "slug": "hairline", "color": "#f3e5d9", "name": "Clay Hairline" },
				{ "slug": "accent-strong", "color": "#9a3412", "name": "Deep Terracotta Rust" },
				{ "slug": "accent-wash", "color": "#fff1eb", "name": "Terracotta Wash" },
				{ "slug": "accent-border", "color": "#fed7aa", "name": "Terracotta Border" },
				{ "slug": "accent-text", "color": "#9a3412", "name": "Terracotta Text" },
				{ "slug": "secondary-wash", "color": "#edf7ed", "name": "Palm Meadow Wash" },
				{ "slug": "secondary-border", "color": "#bbf7d0", "name": "Palm Meadow Border" },
				{ "slug": "secondary-text", "color": "#166534", "name": "Palm Meadow Text" },
				{ "slug": "live", "color": "#c2410c", "name": "Terracotta Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--newsreader)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
