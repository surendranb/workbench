{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Railroad",
	"description": "Southern Railway electric junction: sun-bleached platform concrete canvas, overhead catenary steel rail, cast-iron locomotive shadow ink, Arakkonam WAP-4 locomotive crimson accent, and warning stripe gold.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#f8f6f0", "name": "Railway Platform Concrete" },
				{ "slug": "ink", "color": "#0f1115", "name": "Locomotive Cast Iron Shadow" },
				{ "slug": "accent", "color": "#c0262b", "name": "Locomotive Crimson Red" },
				{ "slug": "secondary", "color": "#ca8a04", "name": "Locomotive Warning Gold" },
				{ "slug": "sidebar", "color": "#e2e7ec", "name": "Catenary Pylon Steel Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#0f1115", "name": "Cast Iron Title" },
				{ "slug": "body", "color": "#1e2229", "name": "Locomotive Steel Body" },
				{ "slug": "lede", "color": "#2c323b", "name": "Steel Lede" },
				{ "slug": "muted", "color": "#525d6c", "name": "Rail Slate Muted" },
				{ "slug": "faint", "color": "#8894a3", "name": "Faint" },
				{ "slug": "border", "color": "#d8ded4", "name": "Ballast Gravel Border" },
				{ "slug": "hairline", "color": "#e8ece5", "name": "Platform Hairline" },
				{ "slug": "accent-strong", "color": "#991b1b", "name": "Deep Locomotive Crimson" },
				{ "slug": "accent-wash", "color": "#fef2f2", "name": "Crimson Accent Wash" },
				{ "slug": "accent-border", "color": "#fecaca", "name": "Crimson Accent Border" },
				{ "slug": "accent-text", "color": "#991b1b", "name": "Crimson Accent Text" },
				{ "slug": "secondary-wash", "color": "#fefce8", "name": "Warning Gold Wash" },
				{ "slug": "secondary-border", "color": "#fef08a", "name": "Warning Gold Border" },
				{ "slug": "secondary-text", "color": "#854d0e", "name": "Warning Gold Text" },
				{ "slug": "live", "color": "#c0262b", "name": "Locomotive Signal Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "700",
					"letterSpacing": "-0.03em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent-strong)" }
				}
			}
		}
	}
}
