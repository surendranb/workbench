{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Chaparral Dusk",
	"description": "California rolling golden oat grass canvas, deep asphalt carbon ink, twilight bay blue, and vibrant sunset amber horizon.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "page", "color": "#f5ede0", "name": "Page" },
				{ "slug": "ink", "color": "#181a1f", "name": "Ink" },
				{ "slug": "title", "color": "#23262d", "name": "Title" },
				{ "slug": "body", "color": "#282c34", "name": "Body" },
				{ "slug": "lede", "color": "#454952", "name": "Lede" },
				{ "slug": "muted", "color": "#636772", "name": "Muted" },
				{ "slug": "faint", "color": "#91949e", "name": "Faint" },
				{ "slug": "border", "color": "#dbceb8", "name": "Border" },
				{ "slug": "hairline", "color": "#ece1ce", "name": "Hairline" },
				{ "slug": "accent", "color": "#d9650d", "name": "Accent" },
				{ "slug": "accent-strong", "color": "#b85106", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fef3ea", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#f7caa6", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#b85106", "name": "Accent Text" },
				{ "slug": "secondary", "color": "#425f7d", "name": "Secondary" },
				{ "slug": "live", "color": "#4a703b", "name": "Live" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			}
		}
	}
}
