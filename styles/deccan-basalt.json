{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Deccan Basalt",
	"description": "Sun-bleached alkali silt canvas, hardened volcanic basalt ink, scorched iron oxide vermillion accent, and weathered agave sage.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#ecece8", "name": "Alkali Silt Canvas" },
				{ "slug": "ink", "color": "#171819", "name": "Volcanic Basalt Ink" },
				{ "slug": "accent", "color": "#c83e24", "name": "Scorched Iron Oxide" },
				{ "slug": "secondary", "color": "#4d695b", "name": "Weathered Agave Sage" },
				{ "slug": "sidebar", "color": "#dcdcd4", "name": "Basalt Quarry Dust Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure Quartz White" },
				{ "slug": "title", "color": "#232526", "name": "Basalt Crust Title" },
				{ "slug": "body", "color": "#343739", "name": "Deep Mineral Body" },
				{ "slug": "lede", "color": "#4a4e51", "name": "Lede" },
				{ "slug": "muted", "color": "#6b7175", "name": "Quarry Silt Muted" },
				{ "slug": "faint", "color": "#9ca2a6", "name": "Faint" },
				{ "slug": "border", "color": "#c7c7be", "name": "Basalt Stone Border" },
				{ "slug": "hairline", "color": "#dfdfd8", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#a62f18", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fdf0ed", "name": "Oxide Wash" },
				{ "slug": "accent-border", "color": "#f8c5ba", "name": "Oxide Border" },
				{ "slug": "accent-text", "color": "#a62f18", "name": "Oxide Text" },
				{ "slug": "secondary-wash", "color": "#eef3f0", "name": "Agave Sage Wash" },
				{ "slug": "secondary-border", "color": "#c0d2c8", "name": "Agave Sage Border" },
				{ "slug": "secondary-text", "color": "#374d42", "name": "Agave Sage Text" },
				{ "slug": "live", "color": "#4d695b", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
