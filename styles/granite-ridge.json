{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Granite Ridge",
	"description": "Cool mountain fog slate canvas, wet basalt rock ink, ridge terracotta clay accent, and misty summit slate.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#eef2f5", "name": "Mountain Fog Slate Canvas" },
				{ "slug": "ink", "color": "#0c151e", "name": "Wet Basalt Ink" },
				{ "slug": "accent", "color": "#bf4e20", "name": "Ridge Terracotta Clay" },
				{ "slug": "secondary", "color": "#3e5d79", "name": "Misty Summit Slate" },
				{ "slug": "sidebar", "color": "#d6dfe6", "name": "Grounded Slate Fog" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#131f2b", "name": "Title" },
				{ "slug": "body", "color": "#213140", "name": "Body" },
				{ "slug": "lede", "color": "#354757", "name": "Lede" },
				{ "slug": "muted", "color": "#5b6e7f", "name": "Muted" },
				{ "slug": "faint", "color": "#8c9dae", "name": "Faint" },
				{ "slug": "border", "color": "#bdcbd6", "name": "Cool Basalt Border" },
				{ "slug": "hairline", "color": "#d8e1e8", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#9c3b12", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fcefe9", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#f3beaa", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#9c3b12", "name": "Accent Text" },
				{ "slug": "live", "color": "#3e5d79", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
