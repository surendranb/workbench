{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Happy Hues",
	"description": "Happy Hues #17 palette: warm cream backdrop, deep navy ink, energetic pink accent, and refreshing teal secondary.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "page", "color": "#fef6e4", "name": "Page" },
				{ "slug": "ink", "color": "#001858", "name": "Ink" },
				{ "slug": "title", "color": "#001858", "name": "Title" },
				{ "slug": "body", "color": "#172c66", "name": "Body" },
				{ "slug": "lede", "color": "#001858", "name": "Lede" },
				{ "slug": "muted", "color": "#637094", "name": "Muted" },
				{ "slug": "faint", "color": "#8c96b0", "name": "Faint" },
				{ "slug": "border", "color": "#e3dac9", "name": "Border" },
				{ "slug": "hairline", "color": "#f3ece0", "name": "Hairline" },
				{ "slug": "accent", "color": "#f582ae", "name": "Accent" },
				{ "slug": "accent-strong", "color": "#d96593", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fef0f5", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#fbc4d8", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#d96593", "name": "Accent Text" },
				{ "slug": "secondary", "color": "#8bd3dd", "name": "Secondary" },
				{ "slug": "live", "color": "#8bd3dd", "name": "Live" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#001858"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			}
		}
	}
}
