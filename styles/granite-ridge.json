{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Granite Ridge",
	"description": "Cool overcast granite fog canvas, wet basalt rock ink, distant mountain slate, and vibrant laterite clay accent.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "page", "color": "#edf1f4", "name": "Page" },
				{ "slug": "ink", "color": "#0e1820", "name": "Ink" },
				{ "slug": "title", "color": "#182430", "name": "Title" },
				{ "slug": "body", "color": "#223140", "name": "Body" },
				{ "slug": "lede", "color": "#364a5c", "name": "Lede" },
				{ "slug": "muted", "color": "#53697d", "name": "Muted" },
				{ "slug": "faint", "color": "#7e93a6", "name": "Faint" },
				{ "slug": "border", "color": "#cbd5de", "name": "Border" },
				{ "slug": "hairline", "color": "#dee6ec", "name": "Hairline" },
				{ "slug": "accent", "color": "#bf4e20", "name": "Accent" },
				{ "slug": "accent-strong", "color": "#a13f15", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fef2ec", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#f7c7b2", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#a13f15", "name": "Accent Text" },
				{ "slug": "secondary", "color": "#4a6882", "name": "Secondary" },
				{ "slug": "live", "color": "#386348", "name": "Live" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			}
		}
	}
}
