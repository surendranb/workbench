{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Coastal Dawn",
	"description": "Deep oceanic navy sea, luminous coastal sand canvas, turquoise seafoam surf, and incandescent coral-sunrise horizon.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "page", "color": "#f7f3eb", "name": "Page" },
				{ "slug": "ink", "color": "#0f222d", "name": "Ink" },
				{ "slug": "title", "color": "#162e3d", "name": "Title" },
				{ "slug": "body", "color": "#1e3847", "name": "Body" },
				{ "slug": "lede", "color": "#2d4c5e", "name": "Lede" },
				{ "slug": "muted", "color": "#5b7585", "name": "Muted" },
				{ "slug": "faint", "color": "#8fa4b0", "name": "Faint" },
				{ "slug": "border", "color": "#ded6c5", "name": "Border" },
				{ "slug": "hairline", "color": "#eee6d5", "name": "Hairline" },
				{ "slug": "accent", "color": "#f25c3b", "name": "Accent" },
				{ "slug": "accent-strong", "color": "#d94423", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fff0ec", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#fbc7ba", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#d94423", "name": "Accent Text" },
				{ "slug": "secondary", "color": "#3e8294", "name": "Secondary" },
				{ "slug": "live", "color": "#3e8294", "name": "Live" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			}
		}
	}
}
