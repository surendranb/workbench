{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Chaparral Dusk",
	"description": "Golden sun-cured oat straw savanna canvas, glowing sunset amber flare, twilight bay blue, and evening crest charcoal.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#f2e7c9", "name": "Golden Oat Straw Canvas" },
				{ "slug": "ink", "color": "#121b28", "name": "Twilight Bay Obsidian" },
				{ "slug": "accent", "color": "#d96b0b", "name": "Sunset Amber Flare" },
				{ "slug": "secondary", "color": "#244c78", "name": "Twilight Bay Blue" },
				{ "slug": "sidebar", "color": "#e1d0a5", "name": "Toasted Golden Straw Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#182436", "name": "Twilight Crest Title" },
				{ "slug": "body", "color": "#2c3b50", "name": "Dusk Atmosphere Body Text" },
				{ "slug": "lede", "color": "#3d4f68", "name": "Lede" },
				{ "slug": "muted", "color": "#5c6e86", "name": "Distant Valley Haze" },
				{ "slug": "faint", "color": "#8897ac", "name": "Faint" },
				{ "slug": "border", "color": "#c8b584", "name": "Golden Straw Trail Border" },
				{ "slug": "hairline", "color": "#dfd0a9", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#b45309", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fef3e7", "name": "Amber Accent Wash" },
				{ "slug": "accent-border", "color": "#fcd8ae", "name": "Amber Accent Border" },
				{ "slug": "accent-text", "color": "#b45309", "name": "Amber Accent Text" },
				{ "slug": "secondary-wash", "color": "#e7eff7", "name": "Twilight Bay Wash" },
				{ "slug": "secondary-border", "color": "#b2cde8", "name": "Twilight Bay Border" },
				{ "slug": "secondary-text", "color": "#183659", "name": "Twilight Bay Text" },
				{ "slug": "live", "color": "#d96b0b", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
