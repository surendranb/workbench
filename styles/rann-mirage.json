{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Rann Mirage",
	"description": "Crystalline gypsum salt wash canvas, deep brine trench indigo ink, mirage dawn copper-rose accent, and horizon brine cyan.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#edf0f4", "name": "Crystalline Gypsum Salt Canvas" },
				{ "slug": "ink", "color": "#0d1a2d", "name": "Deep Brine Trench Indigo" },
				{ "slug": "accent", "color": "#d25438", "name": "Mirage Dawn Copper-Rose" },
				{ "slug": "secondary", "color": "#1b7a96", "name": "Horizon Brine Cyan" },
				{ "slug": "sidebar", "color": "#d9dee6", "name": "Mineral Salt Shadow Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure Salt Crystal White" },
				{ "slug": "title", "color": "#11233d", "name": "Deep Saline Title" },
				{ "slug": "body", "color": "#1b3252", "name": "Brine Indigo Body" },
				{ "slug": "lede", "color": "#2b476e", "name": "Lede" },
				{ "slug": "muted", "color": "#506e94", "name": "Salt Mist Muted" },
				{ "slug": "faint", "color": "#88a2bf", "name": "Faint" },
				{ "slug": "border", "color": "#c3ccd8", "name": "Gypsum Crust Border" },
				{ "slug": "hairline", "color": "#dfe4ec", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#b33f26", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fdf1ee", "name": "Mirage Copper Wash" },
				{ "slug": "accent-border", "color": "#f9c8bd", "name": "Mirage Copper Border" },
				{ "slug": "accent-text", "color": "#b33f26", "name": "Mirage Copper Text" },
				{ "slug": "secondary-wash", "color": "#e7f4f7", "name": "Brine Cyan Wash" },
				{ "slug": "secondary-border", "color": "#a9dbe6", "name": "Brine Cyan Border" },
				{ "slug": "secondary-text", "color": "#115b70", "name": "Brine Cyan Text" },
				{ "slug": "live", "color": "#1b7a96", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
