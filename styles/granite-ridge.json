{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Granite Ridge",
	"description": "High-altitude mountain fog slate canvas, wet basalt rock ink, ridge terracotta clay flare, and summit lake blue.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#e4ebf0", "name": "Mountain Fog Slate Canvas" },
				{ "slug": "ink", "color": "#0d1b2a", "name": "Wet Basalt Navy Ink" },
				{ "slug": "accent", "color": "#bf4e20", "name": "Ridge Terracotta Clay" },
				{ "slug": "secondary", "color": "#2b5c87", "name": "Summit Lake Blue" },
				{ "slug": "sidebar", "color": "#cddbe4", "name": "Grounded Basalt Fog Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#122438", "name": "Summit Ridge Title" },
				{ "slug": "body", "color": "#1e364e", "name": "Alpine Slate Body Text" },
				{ "slug": "lede", "color": "#2d4c6a", "name": "Lede" },
				{ "slug": "muted", "color": "#4f6d8a", "name": "Fog Shroud Muted" },
				{ "slug": "faint", "color": "#8199b0", "name": "Faint" },
				{ "slug": "border", "color": "#b2c5d4", "name": "Weathered Granite Border" },
				{ "slug": "hairline", "color": "#d1dee8", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#9c3b12", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fdf0eb", "name": "Terracotta Accent Wash" },
				{ "slug": "accent-border", "color": "#f5beaa", "name": "Terracotta Accent Border" },
				{ "slug": "accent-text", "color": "#9c3b12", "name": "Terracotta Accent Text" },
				{ "slug": "secondary-wash", "color": "#e7f1f8", "name": "Summit Lake Wash" },
				{ "slug": "secondary-border", "color": "#b5d3ea", "name": "Summit Lake Border" },
				{ "slug": "secondary-text", "color": "#194164", "name": "Summit Lake Text" },
				{ "slug": "live", "color": "#2b5c87", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
