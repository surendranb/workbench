{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Happy Hues #17",
	"description": "Studio house palette: warm cream, deep navy, electric pink, and luminous teal.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#fef6e4", "name": "Studio Cream Canvas" },
				{ "slug": "ink", "color": "#001858", "name": "Studio Deep Navy" },
				{ "slug": "accent", "color": "#f582ae", "name": "Studio Electric Pink" },
				{ "slug": "secondary", "color": "#8bd3dd", "name": "Studio Luminous Teal" },
				{ "slug": "sidebar", "color": "#f3e2ba", "name": "Grounded Warm Cream" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#001858", "name": "Title" },
				{ "slug": "body", "color": "#172554", "name": "Body" },
				{ "slug": "lede", "color": "#1e293b", "name": "Lede" },
				{ "slug": "muted", "color": "#475569", "name": "Muted" },
				{ "slug": "faint", "color": "#64748b", "name": "Faint" },
				{ "slug": "border", "color": "#dcc89b", "name": "Warm Cream-Navy Border" },
				{ "slug": "hairline", "color": "#ede0c2", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#db6894", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fef0f5", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#fbc3d7", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#001858", "name": "Accent Text" },
				{ "slug": "live", "color": "#10b981", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#001858"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
