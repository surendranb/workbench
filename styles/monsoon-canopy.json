{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Monsoon Canopy",
	"description": "Rain-drenched evergreen moss canvas, shola forest river stones, deep Malabar wet obsidian ink, and wild cardamom ginger amber.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#e6ebe6", "name": "Wet Moss Mist Canvas" },
				{ "slug": "ink", "color": "#0b1e16", "name": "Deep Malabar Wet Obsidian" },
				{ "slug": "accent", "color": "#b45309", "name": "Wild Cardamom Ginger Amber" },
				{ "slug": "secondary", "color": "#247158", "name": "Shola River Jade" },
				{ "slug": "sidebar", "color": "#d2ded4", "name": "Rain-Cloud Forest Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#112b20", "name": "Forest Canopy Title" },
				{ "slug": "body", "color": "#1b3d30", "name": "Evergreen Pine Body" },
				{ "slug": "lede", "color": "#295242", "name": "Lede" },
				{ "slug": "muted", "color": "#507565", "name": "Shola Mist Muted" },
				{ "slug": "faint", "color": "#809e90", "name": "Faint" },
				{ "slug": "border", "color": "#b8ccbe", "name": "Rain-Stone Border" },
				{ "slug": "hairline", "color": "#d7e3da", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#92400e", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fef3c7", "name": "Ginger Wash" },
				{ "slug": "accent-border", "color": "#fde68a", "name": "Ginger Border" },
				{ "slug": "accent-text", "color": "#92400e", "name": "Ginger Text" },
				{ "slug": "secondary-wash", "color": "#eaf3ed", "name": "River Jade Wash" },
				{ "slug": "secondary-border", "color": "#b7d8c8", "name": "River Jade Border" },
				{ "slug": "secondary-text", "color": "#165440", "name": "River Jade Text" },
				{ "slug": "live", "color": "#247158", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
