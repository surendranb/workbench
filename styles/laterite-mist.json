{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Laterite Mist",
	"description": "Nandi Hills landscape: warm plowed laterite red earth, deep umber ink, palm canopy green, and cool cloud mist.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "page", "color": "#faf7f2", "name": "Page" },
				{ "slug": "ink", "color": "#2c1e15", "name": "Ink" },
				{ "slug": "title", "color": "#3a2a1f", "name": "Title" },
				{ "slug": "body", "color": "#382a20", "name": "Body" },
				{ "slug": "lede", "color": "#422e22", "name": "Lede" },
				{ "slug": "muted", "color": "#756457", "name": "Muted" },
				{ "slug": "faint", "color": "#9e8e82", "name": "Faint" },
				{ "slug": "border", "color": "#e8dfd5", "name": "Border" },
				{ "slug": "hairline", "color": "#f3ede5", "name": "Hairline" },
				{ "slug": "accent", "color": "#b8572b", "name": "Accent" },
				{ "slug": "accent-strong", "color": "#a0471e", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fdf4ef", "name": "Accent Wash" },
				{ "slug": "accent-border", "color": "#f2cfbe", "name": "Accent Border" },
				{ "slug": "accent-text", "color": "#b8572b", "name": "Accent Text" },
				{ "slug": "secondary", "color": "#52634e", "name": "Secondary" },
				{ "slug": "live", "color": "#52634e", "name": "Live" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			}
		}
	}
}
