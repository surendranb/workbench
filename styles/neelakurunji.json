{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Neelakurunji",
	"description": "The mythical 12-year Shola bloom: warm dusk sky canvas, lush green mountain meadow rail, deep evergreen forest ink, vibrant Kurinji blossom violet, and radiant dusk sunset orange.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#fdf9f4", "name": "Dusk Sky Canvas" },
				{ "slug": "ink", "color": "#0d241d", "name": "Shola Forest Shadow" },
				{ "slug": "accent", "color": "#664de5", "name": "Neelakurunji Blossom Violet" },
				{ "slug": "secondary", "color": "#ea580c", "name": "Dusk Sunset Orange" },
				{ "slug": "sidebar", "color": "#edf5f0", "name": "Lush Shola Meadow Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Alpine Cloud Surface" },
				{ "slug": "title", "color": "#0d241d", "name": "Shola Deep Title" },
				{ "slug": "body", "color": "#1a3b30", "name": "Shola Moss Body" },
				{ "slug": "lede", "color": "#295244", "name": "Shola Canopy Lede" },
				{ "slug": "muted", "color": "#4d6e61", "name": "Pine Mist Muted" },
				{ "slug": "faint", "color": "#7e9c90", "name": "Distant Ridge Faint" },
				{ "slug": "border", "color": "#cde0d5", "name": "Alpine Meadow Border" },
				{ "slug": "hairline", "color": "#dfede5", "name": "Shola Hairline" },
				{ "slug": "accent-strong", "color": "#5137d1", "name": "Deep Kurinji Petal" },
				{ "slug": "accent-wash", "color": "#f3effd", "name": "Violet Blossom Wash" },
				{ "slug": "accent-border", "color": "#ded5fb", "name": "Violet Blossom Border" },
				{ "slug": "accent-text", "color": "#4a32be", "name": "Violet Blossom Text" },
				{ "slug": "secondary-wash", "color": "#fff4ea", "name": "Sunset Glow Wash" },
				{ "slug": "secondary-border", "color": "#fed7aa", "name": "Sunset Glow Border" },
				{ "slug": "secondary-text", "color": "#c2410c", "name": "Sunset Dusk Text" },
				{ "slug": "live", "color": "#664de5", "name": "Blooming Kurinji Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
					"fontWeight": "800",
					"letterSpacing": "-0.035em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
