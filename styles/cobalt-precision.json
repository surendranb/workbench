{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Cobalt Precision",
	"description": "Surgical devtool precision: icy blue-white substrate, cool slate structural rail, obsidian ink, electric cobalt blue accent, and Geist geometric typography.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#f4f6fa", "name": "Icy Dev White Canvas" },
				{ "slug": "ink", "color": "#09111e", "name": "Obsidian Deep Ink" },
				{ "slug": "accent", "color": "#2563eb", "name": "Electric Klein Cobalt" },
				{ "slug": "secondary", "color": "#0284c7", "name": "Precision Steel Cyan" },
				{ "slug": "sidebar", "color": "#e8edf5", "name": "Cool Slate Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#09111e", "name": "Obsidian Title" },
				{ "slug": "body", "color": "#1e293b", "name": "Deep Slate Navy Body" },
				{ "slug": "lede", "color": "#334155", "name": "Slate Lede" },
				{ "slug": "muted", "color": "#64748b", "name": "Slate Muted" },
				{ "slug": "faint", "color": "#94a3b8", "name": "Faint" },
				{ "slug": "border", "color": "#cbd5e1", "name": "Cool Slate Border" },
				{ "slug": "hairline", "color": "#e2e8f0", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#1d4ed8", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#eff6ff", "name": "Cobalt Wash" },
				{ "slug": "accent-border", "color": "#bfdbfe", "name": "Cobalt Border" },
				{ "slug": "accent-text", "color": "#1d4ed8", "name": "Cobalt Text" },
				{ "slug": "secondary-wash", "color": "#f0f9ff", "name": "Cyan Wash" },
				{ "slug": "secondary-border", "color": "#bae6fd", "name": "Cyan Border" },
				{ "slug": "secondary-text", "color": "#0369a1", "name": "Cyan Text" },
				{ "slug": "live", "color": "#0284c7", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--geist)",
					"fontWeight": "750",
					"letterSpacing": "-0.035em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
