{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Happy Hues #17",
	"description": "Studio house palette: warm cream canvas, deep navy ink, electric pink accent, and rich luminous teal.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "page", "color": "#fef6e4", "name": "Studio Cream Canvas" },
				{ "slug": "ink", "color": "#001858", "name": "Studio Deep Navy" },
				{ "slug": "accent", "color": "#f582ae", "name": "Studio Electric Pink" },
				{ "slug": "secondary", "color": "#008b99", "name": "Studio Luminous Teal" },
				{ "slug": "sidebar", "color": "#f3e0b5", "name": "Grounded Warm Cream Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#001858", "name": "Studio Deep Navy Title" },
				{ "slug": "body", "color": "#122468", "name": "Rich Studio Navy Body" },
				{ "slug": "lede", "color": "#1e3582", "name": "Lede" },
				{ "slug": "muted", "color": "#48598a", "name": "Navy Muted" },
				{ "slug": "faint", "color": "#7886ad", "name": "Faint" },
				{ "slug": "border", "color": "#d8c292", "name": "Warm Sand Border" },
				{ "slug": "hairline", "color": "#ecd9b4", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#db6894", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#feecf3", "name": "Pink Accent Wash" },
				{ "slug": "accent-border", "color": "#fbc2d6", "name": "Pink Accent Border" },
				{ "slug": "accent-text", "color": "#001858", "name": "Pink Accent Text" },
				{ "slug": "secondary-wash", "color": "#e5f8fa", "name": "Teal Wash" },
				{ "slug": "secondary-border", "color": "#9ee5ec", "name": "Teal Border" },
				{ "slug": "secondary-text", "color": "#005963", "name": "Teal Text" },
				{ "slug": "live", "color": "#008b99", "name": "Live Indicator" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#001858"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		}
	}
}
