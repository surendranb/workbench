{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "project",
			"title": "Project (with notes card)",
			"postTypes": ["page"]
		}
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "1120px",
			"wideSize": "1280px"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "page", "color": "#fef6e4", "name": "Studio Cream Canvas" },
				{ "slug": "ink", "color": "#001858", "name": "Studio Deep Navy" },
				{ "slug": "accent", "color": "#f582ae", "name": "Studio Electric Pink" },
				{ "slug": "secondary", "color": "#008b99", "name": "Studio Luminous Teal" },
				{ "slug": "sidebar", "color": "#f4e5c2", "name": "Sunlight Biscuit Rail" },
				{ "slug": "surface", "color": "#ffffff", "name": "Pure White Surface" },
				{ "slug": "title", "color": "#001858", "name": "Studio Deep Navy Title" },
				{ "slug": "body", "color": "#172c69", "name": "Rich Studio Navy Body" },
				{ "slug": "lede", "color": "#263f82", "name": "Studio Navy Lede" },
				{ "slug": "muted", "color": "#52669e", "name": "Studio Navy Muted" },
				{ "slug": "faint", "color": "#8898c7", "name": "Faint" },
				{ "slug": "border", "color": "#decba4", "name": "Warm Cream Border" },
				{ "slug": "hairline", "color": "#ebdcc0", "name": "Hairline" },
				{ "slug": "accent-strong", "color": "#db2777", "name": "Accent Strong" },
				{ "slug": "accent-wash", "color": "#fdf2f6", "name": "Pink Accent Wash" },
				{ "slug": "accent-border", "color": "#fbcfe8", "name": "Pink Accent Border" },
				{ "slug": "accent-text", "color": "#9d174d", "name": "Pink Accent Text" },
				{ "slug": "secondary-wash", "color": "#e6f9fa", "name": "Teal Wash" },
				{ "slug": "secondary-border", "color": "#a3eaee", "name": "Teal Border" },
				{ "slug": "secondary-text", "color": "#00636d", "name": "Teal Text" },
				{ "slug": "live", "color": "#008b99", "name": "Live Indicator" }
			]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "primary",
					"name": "Inter",
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/InterVariable.woff2"]
						}
					]
				},
				{
					"slug": "display",
					"name": "Newsreader",
					"fontFamily": "'Newsreader', 'Iowan Old Style', Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/newsreader-normal.woff2"]
						}
					]
				},
				{
					"slug": "geist",
					"name": "Geist",
					"fontFamily": "'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Geist",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/geist-latin.woff2"]
						}
					]
				},
				{
					"slug": "space-grotesk",
					"name": "Space Grotesk",
					"fontFamily": "'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontWeight": "300 700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/space-grotesk-latin.woff2"]
						}
					]
				},
				{
					"slug": "bricolage-grotesque",
					"name": "Bricolage Grotesque",
					"fontFamily": "'Bricolage Grotesque', -apple-system, BlinkMacSystemFont, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/bricolage-grotesque-latin.woff2"]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "tiny", "size": "11px", "name": "Tiny" },
				{ "slug": "caption", "size": "12px", "name": "Caption" },
				{ "slug": "base", "size": "13px", "name": "Base" },
				{ "slug": "body", "size": "15px", "name": "Body" },
				{ "slug": "lede", "size": "19px", "name": "Lede" },
				{ "slug": "hero", "size": "clamp(34px, 5vw, 42px)", "name": "Hero" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.62"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
					"fontWeight": "800",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
					"fontSize": "var(--wp--preset--font-size--hero)",
					"fontWeight": "850",
					"lineHeight": "1.1",
					"letterSpacing": "-0.035em"
				},
				"spacing": {
					"margin": { "bottom": "16px" }
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
					"fontSize": "24px",
					"fontWeight": "800",
					"letterSpacing": "-0.025em"
				},
				"spacing": {
					"margin": { "top": "2em", "bottom": "12px" }
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
					"fontSize": "19px",
					"fontWeight": "750",
					"letterSpacing": "-0.02em"
				},
				"spacing": {
					"margin": { "top": "1.6em", "bottom": "10px" }
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent-strong)" },
					"typography": { "textDecoration": "underline" }
				}
			},
			"button": {
				"border": { "radius": "8px" },
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#001858"
				},
				"typography": {
					"fontWeight": "800",
					"fontSize": "13px",
					"fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)"
				},
				"spacing": {
					"padding": {
						"top": "11px",
						"bottom": "11px",
						"left": "16px",
						"right": "16px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "#ffffff"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--faint)" },
				"typography": { "fontSize": "12px" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
					"fontSize": "clamp(15px, 0.875rem + ((1vw - 3.2px) * 0.392), 19px)",
					"fontWeight": "850",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontSize": "13px",
					"lineHeight": "1.5"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
					"fontSize": "var(--wp--preset--font-size--hero)",
					"fontWeight": "850",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "13px",
					"lineHeight": "1.5"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			},
			"core/post-date": {
				"typography": { "fontSize": "12px" },
				"color": { "text": "var(--wp--preset--color--faint)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "13px",
					"lineHeight": "1.6"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--title)"
				},
				"border": {
					"radius": "8px",
					"color": "var(--wp--preset--color--border)",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "16px",
						"bottom": "16px",
						"left": "20px",
						"right": "20px"
					}
				}
			},
			"core/preformatted": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "13px",
					"lineHeight": "1.6"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--title)"
				},
				"border": {
					"radius": "8px",
					"color": "var(--wp--preset--color--border)",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "16px",
						"bottom": "16px",
						"left": "20px",
						"right": "20px"
					}
				}
			},
			"core/table": {
				"typography": { "fontSize": "13px" },
				"border": {
					"color": "var(--wp--preset--color--border)",
					"width": "1px"
				}
			},
			"core/image": {
				"border": { "radius": "8px" }
			}
		}
	}
}
